---
import path from "path";
import { Image } from "astro:assets";
import { getFallbackFormat, getImageQuality } from "@/utils/image-utils";
import { url } from "../../utils/url-utils";

interface Props {
  id?: string;
  src: string;
  class?: string;
  alt?: string;
  position?: string;
  basePath?: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  quality?: number;
  loading?: "eager" | "lazy";
  decoding?: "sync" | "async" | "auto";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  id,
  src,
  alt,
  position = "center",
  basePath = "/",
  width,
  height,
  widths,
  sizes,
  quality = getImageQuality(),
  loading = "lazy",
  decoding = "async",
  fetchpriority,
} = Astro.props;
const className = Astro.props.class;
// 用 Image + format，避免 Picture 外包 <picture> 导致布局塌陷
const outputFormat = getFallbackFormat();

const isLocal = !(
  src.startsWith("/") ||
  src.startsWith("http") ||
  src.startsWith("https") ||
  src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// 保持与改前一致的 glob，避免路径 key 对不上导致图片/依赖区域空白
let img;
if (isLocal) {
  const files = import.meta.glob<ImageMetadata>("../../**", {
    import: "default",
  });
  let normalizedPath = path
    .normalize(path.join("../../", basePath, src))
    .replace(/\\/g, "/");
  const file = files[normalizedPath];
  if (!file) {
    console.error(
      `\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
    );
  }
  img = await file();
}

const imageClass = "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---

<div id={id} class:list={[className, "overflow-hidden relative"]}>
  <div
    class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"
  >
  </div>
  {
    isLocal && img && (
      <Image
        src={img}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        width={width}
        height={height}
        widths={widths}
        sizes={sizes}
        quality={quality}
        format={outputFormat}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    )
  }
  {
    !isLocal && (
      <img
        src={isPublic ? url(src) : src}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        width={width}
        height={height}
        sizes={sizes}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    )
  }
</div>
