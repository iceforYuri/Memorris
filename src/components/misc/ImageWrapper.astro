---
import path from "path";
import { Image } from "astro:assets";
import { getFallbackFormat, getImageQuality } from "@/utils/image-utils";
import { getLqipProps } from "@/utils/lqip-utils";
import { url } from "../../utils/url-utils";

interface Props {
  id?: string;
  src: string;
  class?: string;
  alt?: string;
  position?: string;
  basePath?: string;
  width?: number;
  height?: number;
  widths?: number[];
  sizes?: string;
  quality?: number;
  loading?: "eager" | "lazy";
  decoding?: "sync" | "async" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  /** 是否显示 LQIP 渐变占位（默认 true） */
  showLqip?: boolean;
}

const {
  id,
  src,
  alt,
  position = "center",
  basePath = "/",
  width,
  height,
  widths,
  sizes,
  quality = getImageQuality(),
  loading = "lazy",
  decoding = "async",
  fetchpriority,
  showLqip = true,
} = Astro.props;
const className = Astro.props.class;
const outputFormat = getFallbackFormat();

const isLocal = !(
  src.startsWith("/") ||
  src.startsWith("http") ||
  src.startsWith("https") ||
  src.startsWith("data:")
);
const isPublic = src.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
let img;
if (isLocal) {
  const files = import.meta.glob<ImageMetadata>("../../**", {
    import: "default",
  });
  let normalizedPath = path
    .normalize(path.join("../../", basePath, src))
    .replace(/\\/g, "/");
  const file = files[normalizedPath];
  if (!file) {
    console.error(
      `\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
    );
  }
  img = await file();
}

const normalizedBasePath =
  typeof basePath === "string" ? basePath.replace(/\\/g, "/") : basePath;
const lqipProps = isLocal
  ? getLqipProps(src, normalizedBasePath)
  : isPublic
    ? getLqipProps(src, undefined, true)
    : getLqipProps(src);

const imageClass = showLqip
  ? "relative z-[1] w-full h-full object-cover opacity-0 transition-opacity duration-500 ease-out"
  : "w-full h-full object-cover";
const imageStyle = `object-position: ${position}`;
---

<div id={id} class:list={[className, "overflow-hidden relative"]}>
  {
    showLqip && (
      <div
        class="lqip-placeholder absolute inset-0 pointer-events-none"
        style={lqipProps.style}
        aria-hidden="true"
      />
    )
  }
  <div
    class="transition absolute inset-0 z-[2] dark:bg-black/10 bg-opacity-50 pointer-events-none"
  >
  </div>
  {
    isLocal && img && (
      <Image
        src={img}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        width={width}
        height={height}
        widths={widths}
        sizes={sizes}
        quality={quality}
        format={outputFormat}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    )
  }
  {
    !isLocal && (
      <img
        src={isPublic ? url(src) : src}
        alt={alt || ""}
        class={imageClass}
        style={imageStyle}
        width={width}
        height={height}
        sizes={sizes}
        loading={loading}
        decoding={decoding}
        fetchpriority={fetchpriority}
      />
    )
  }
</div>
