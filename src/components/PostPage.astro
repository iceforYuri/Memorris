---
import { getPostUrlBySlug } from '@utils/url-utils'
import PostCard from './PostCard.astro'

const { page } = Astro.props

let delay = 0
const interval = 50

/** 列表前 N 张封面 eager，利于首屏 LCP；不设 fetchpriority=high，避免与 banner 抢带宽 */
const EAGER_COVER_COUNT = 2
---
<div class="transition flex flex-col rounded-[var(--radius-large)] bg-[var(--card-bg)] py-1 md:py-0 md:bg-transparent md:gap-4 mb-4">
    {page.data.map((entry: { data: { draft: boolean; title: string; tags: string[]; category: string; published: Date; image: string; description: string; updated: Date; }; slug: string; }, index: number) => {
        return (
            <PostCard
                    entry={entry}
                    title={entry.data.title}
                    tags={entry.data.tags}
                    category={entry.data.category}
                    published={entry.data.published}
                    updated={entry.data.updated}
                    url={getPostUrlBySlug(entry.slug)}
                    image={entry.data.image}
                    description={entry.data.description}
                    draft={entry.data.draft}
                    loading={index < EAGER_COVER_COUNT ? "eager" : "lazy"}
                    class:list="onload-animation"
                    style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
            ></PostCard>
        );
    })}
</div>
