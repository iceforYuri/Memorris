---
// 仅 latin 子集：中文 UI 不走 Roboto，全量子集会白白拉取 cyrillic/greek/math 等
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";

import "../styles/variables.css";
import "../styles/main.css";
import "../styles/markdown.css";
import "../styles/transition.css";
import "../styles/markdown-extend.styl";
import "../styles/scrollbar.css";
import "../styles/wallpaper.css";

import {
	profileConfig,
	siteConfig,
} from "@/config";
import {
	resolveWallpaperModeForBuild,
	shouldRenderWallpaperGradient,
	wallpaper,
} from "@/config/wallpaper";
import ConfigCarrier from "@components/ConfigCarrier.astro";
import {
	AUTO_MODE,
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	BANNER_HEIGHT_HOME,
	DARK_MODE,
	DEFAULT_THEME,
	LIGHT_MODE,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
	PAGE_WIDTH,
} from "../constants/constants";
import { defaultFavicons } from "../constants/icon";
import type { Favicon } from "../types/config";
import { url, pathsEqual } from "../utils/url-utils";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
}

let { title, banner, description, lang, setOGTypeArticle } = Astro.props;

// apply a class to the body element to decide the height of the banner, only used for initial page load
// Swup can update the body for each page visit, but it's after the page transition, causing a delay for banner height change
// so use Swup hooks instead to change the height immediately when a link is clicked
const isHomePage = pathsEqual(Astro.url.pathname, url("/"));

// defines global css variables
// why doing this in Layout instead of GlobalStyles: https://github.com/withastro/astro/issues/6728#issuecomment-1502203757
const configHue = siteConfig.themeColor.hue;
if (!banner || typeof banner !== "string" || banner.trim() === "") {
	banner = siteConfig.banner.src;
}

// TODO don't use post cover as banner for now
banner = siteConfig.banner.src;

const wallpaperMode = resolveWallpaperModeForBuild();
/** 仅 banner 模式启用半屏壳层位移（lg:is-home + duration-700） */
const enableBanner = wallpaperMode === "banner";
const noWallpaperLayout =
	wallpaperMode === "none" ||
	wallpaperMode === "overlay" ||
	wallpaperMode === "fullscreen";

let pageTitle: string;
if (title) {
	pageTitle = `${title} - ${siteConfig.title}`;
} else {
	pageTitle = `${siteConfig.title} - ${siteConfig.subtitle}`;
}

const favicons: Favicon[] =
	siteConfig.favicon.length > 0 ? siteConfig.favicon : defaultFavicons;

// const siteLang = siteConfig.lang.replace('_', '-')
if (!lang) {
	lang = `${siteConfig.lang}`;
}
const siteLang = lang.replace("_", "-");

const bannerOffsetByPosition = {
	top: `${BANNER_HEIGHT_EXTEND}vh`,
	center: `${BANNER_HEIGHT_EXTEND / 2}vh`,
	bottom: "0",
};
const bannerOffset =
	bannerOffsetByPosition[
		wallpaper.banner.position || siteConfig.banner.position || "center"
	];
const gradientEnabled = shouldRenderWallpaperGradient();
---

<!doctype html>
<html
	lang={siteLang}
	class="bg-[var(--page-bg)] transition text-[14px] md:text-[16px]"
	data-wallpaper-mode={wallpaperMode}
	data-gradient-enabled={gradientEnabled ? "true" : "false"}
	style={{
		"--main-panel-top-banner": `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`,
		"--banner-wrapper-offset": `-${BANNER_HEIGHT_EXTEND}vh`,
		"--wallpaper-overlay-opacity": String(wallpaper.overlay.opacity),
		"--wallpaper-overlay-blur": `${wallpaper.overlay.blur}px`,
		"--wallpaper-card-opacity": String(wallpaper.overlay.cardOpacity),
		"--wallpaper-overlay-z-index": String(wallpaper.overlay.zIndex),
	}}
>
	<head>
		<title>{pageTitle}</title>

		<meta charset="UTF-8" />
		<meta name="description" content={description || pageTitle} />
		<meta name="author" content={profileConfig.name} />

		<meta property="og:site_name" content={siteConfig.title} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description || pageTitle} />
		{
			setOGTypeArticle ? (
				<meta property="og:type" content="article" />
			) : (
				<meta property="og:type" content="website" />
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={Astro.url} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description || pageTitle} />

		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		{
			favicons.map((favicon) => (
				<link
					rel="icon"
					href={
						favicon.src.startsWith("/")
							? url(favicon.src)
							: favicon.src
					}
					sizes={favicon.sizes}
					media={
						favicon.theme &&
						`(prefers-color-scheme: ${favicon.theme})`
					}
				/>
			))
		}

		<!-- Set the theme before the page is rendered to avoid a flash -->
		<script
			is:inline
			define:vars={{
				DEFAULT_THEME,
				LIGHT_MODE,
				DARK_MODE,
				AUTO_MODE,
				BANNER_HEIGHT_EXTEND,
				PAGE_WIDTH,
				configHue,
			}}
		>
			// Load the theme from local storage
			const theme = localStorage.getItem("theme") || DEFAULT_THEME;
			switch (theme) {
				case LIGHT_MODE:
					document.documentElement.classList.remove("dark");
					break;
				case DARK_MODE:
					document.documentElement.classList.add("dark");
					break;
				case AUTO_MODE:
					if (
						window.matchMedia("(prefers-color-scheme: dark)")
							.matches
					) {
						document.documentElement.classList.add("dark");
					} else {
						document.documentElement.classList.remove("dark");
					}
			}

			// Load the hue from local storage
			const hue = localStorage.getItem("hue") || configHue;
			document.documentElement.style.setProperty("--hue", hue);

			// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
			let offset = Math.floor(
				window.innerHeight * (BANNER_HEIGHT_EXTEND / 100),
			);
			offset = offset - (offset % 4);
			document.documentElement.style.setProperty(
				"--banner-height-extend",
				`${offset}px`,
			);
		</script>
		<style
			define:vars={{
				configHue,
				"page-width": `${PAGE_WIDTH}rem`,
			}}
		></style>
		<!-- defines global css variables. This will be applied to <html> <body> and some other elements idk why -->

		<slot name="head" />

		<link
			rel="alternate"
			type="application/rss+xml"
			title={profileConfig.name}
			href={`${Astro.site}rss.xml`}
		/>
	</head>
	<body
		class="min-h-screen transition"
		class:list={[
			{
				"lg:is-home": isHomePage,
				"enable-banner": enableBanner,
				"wallpaper-overlay-active": wallpaperMode === "overlay",
				"no-wallpaper-layout": noWallpaperLayout,
			},
		]}
	>
		{
			wallpaper.switchable && (
				<script
					is:inline
					define:vars={{
						defaultWallpaperMode: wallpaper.mode,
						bannerSiteEnabled: siteConfig.banner.enable,
					}}
				>
					{`(function () {
						var modes = ["banner", "fullscreen", "overlay", "none"];
						var mode = localStorage.getItem("wallpaperMode") || defaultWallpaperMode;
						if (modes.indexOf(mode) < 0) mode = defaultWallpaperMode;
						if (!bannerSiteEnabled) mode = "none";
						document.documentElement.setAttribute("data-wallpaper-mode", mode);
						var body = document.body;
						body.classList.remove("enable-banner", "wallpaper-overlay-active", "no-wallpaper-layout");
						if (mode === "banner") body.classList.add("enable-banner");
						else if (mode === "overlay") body.classList.add("wallpaper-overlay-active", "no-wallpaper-layout");
						else body.classList.add("no-wallpaper-layout");
						var op = localStorage.getItem("wallpaperOverlayOpacity");
						var blur = localStorage.getItem("wallpaperOverlayBlur");
						var card = localStorage.getItem("wallpaperOverlayCardOpacity");
						var root = document.documentElement;
						if (op !== null) root.style.setProperty("--wallpaper-overlay-opacity", op);
						if (blur !== null) root.style.setProperty("--wallpaper-overlay-blur", blur + "px");
						if (card !== null) root.style.setProperty("--wallpaper-card-opacity", card);
					})();`}
				</script>
			)
		}
		<ConfigCarrier />
		<slot />

		<!-- increase the page height during page transition to prevent the scrolling animation from jumping -->
		<div id="page-height-extend" class="hidden h-[300vh]"></div>
	</body>
</html>

<style
	is:global
	define:vars={{
		bannerOffset,
		"banner-height-home": `${BANNER_HEIGHT_HOME}vh`,
		"banner-height": `${BANNER_HEIGHT}vh`,
	}}
>
	@tailwind components;
	@layer components {
		html[data-wallpaper-mode="banner"] .enable-banner.lg\:is-home #wallpaper-wrapper {
			@apply h-[var(--banner-height-home)] translate-y-[var(--banner-height-extend)];
		}
		html[data-wallpaper-mode="banner"] .enable-banner #wallpaper-wrapper {
			@apply h-[var(--banner-height-home)];
		}

		html[data-wallpaper-mode="banner"] .enable-banner.lg\:is-home #banner {
			@apply h-[var(--banner-height-home)] translate-y-0;
		}
		html[data-wallpaper-mode="banner"] .enable-banner #banner {
			@apply h-[var(--banner-height-home)] translate-y-[var(--bannerOffset)];
		}
		html[data-wallpaper-mode="banner"] .enable-banner.lg\:is-home #main-grid {
			@apply translate-y-[var(--banner-height-extend)];
		}
		html[data-wallpaper-mode="banner"] .enable-banner #top-row {
			@apply h-[calc(var(--banner-height-home)_-_4.5rem)] transition-all duration-300;
		}
		html[data-wallpaper-mode="banner"] .enable-banner.lg\:is-home #sidebar-sticky {
			@apply top-[calc(1rem_-_var(--banner-height-extend))];
		}
		.navbar-hidden {
			@apply opacity-0 -translate-y-16;
		}

		/* LQIP 占位渐变：图片加载后淡出 */
		.lqip-placeholder {
			z-index: 0;
			transition: opacity 0.5s ease-out;
		}
		.lqip-placeholder.loaded {
			opacity: 0;
		}
	}
</style>

<script>
	import {
		getHue,
		getStoredTheme,
		setHue,
		setTheme,
	} from "../utils/setting-utils";
	import { pathsEqual, url } from "../utils/url-utils";
	import {
		getPathnameFromVisitUrl,
		handleWallpaperPageView,
		handleWallpaperVisitStart,
		handleWallpaperScrollTop,
		initWallpaperFromStorage,
		scrollToFullscreenContent,
		syncWallpaperLayoutOnResize,
	} from "../utils/wallpaper-utils";
	import {
		BANNER_HEIGHT,
		BANNER_HEIGHT_HOME,
		BANNER_HEIGHT_EXTEND,
		MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
		PAGE_WIDTH,
	} from "../constants/constants";

	/* Preload fonts */
	// (async function() {
	// 	try {
	// 		await Promise.all([
	// 			document.fonts.load("400 1em Roboto"),
	// 			document.fonts.load("700 1em Roboto"),
	// 		]);
	// 		document.body.classList.remove("hidden");
	// 	} catch (error) {
	// 		console.log("Failed to load fonts:", error);
	// 	}
	// })();

	/* TODO This is a temporary solution for style flicker issue when the transition is activated */
	/* issue link: https://github.com/withastro/astro/issues/8711, the solution get from here too */
	/* update: fixed in Astro 3.2.4 */
	/*
function disableAnimation() {
	const css = document.createElement('style')
	css.appendChild(
		document.createTextNode(
			`*{
              -webkit-transition:none!important;
              -moz-transition:none!important;
              -o-transition:none!important;
              -ms-transition:none!important;
              transition:none!important
              }`
		)
	)
	document.head.appendChild(css)

	return () => {
		// Force restyle
		;(() => window.getComputedStyle(document.body))()

		// Wait for next tick before removing
		setTimeout(() => {
			document.head.removeChild(css)
		}, 1)
	}
}
*/

	function isBannerWallpaperMode() {
		return (
			document.documentElement.getAttribute("data-wallpaper-mode") ===
				"banner" && !!document.getElementById("wallpaper-wrapper")
		);
	}

	function bindWhenSwupReady(bind: () => void, boundKey: string) {
		const tryBind = () => {
			if ((window as any)[boundKey]) return true;
			if (!window?.swup?.hooks) return false;
			(window as any)[boundKey] = true;
			bind();
			return true;
		};

		if (tryBind()) return;

		const retry = () => {
			tryBind();
		};
		window.addEventListener("load", retry, { once: true });
		document.addEventListener("astro:page-load", retry);

		let attempts = 0;
		const timer = window.setInterval(() => {
			if (tryBind() || ++attempts > 400) {
				window.clearInterval(timer);
			}
		}, 50);
	}

	function setClickOutsideToClose(panel: string, ignores: string[]) {
		const boundKey = `__layoutClickOutsideBound_${panel}`;
		if ((window as any)[boundKey]) return;
		(window as any)[boundKey] = true;
		document.addEventListener("click", (event) => {
			let panelDom = document.getElementById(panel);
			let tDom = event.target;
			if (!(tDom instanceof Node)) return; // Ensure the event target is an HTML Node
			for (let ig of ignores) {
				let ie = document.getElementById(ig);
				if (ie == tDom || ie?.contains(tDom)) {
					return;
				}
			}
			panelDom!.classList.add("float-panel-closed");
		});
	}
	setClickOutsideToClose("display-setting", [
		"display-setting",
		"display-settings-switch",
	]);
	setClickOutsideToClose("nav-menu-panel", [
		"nav-menu-panel",
		"nav-menu-switch",
	]);
	setClickOutsideToClose("search-panel", [
		"search-panel",
		"search-bar",
		"search-switch",
	]);

	function loadTheme() {
		const theme = getStoredTheme();
		setTheme(theme);
	}

	function loadHue() {
		setHue(getHue());
	}

	let overlayScrollbarsLoader: Promise<any> | undefined;

	function loadOverlayScrollbars() {
		if (!overlayScrollbarsLoader) {
			overlayScrollbarsLoader = Promise.all([
				import("overlayscrollbars"),
				import("overlayscrollbars/overlayscrollbars.css"),
			]).then(([module]) => module);
		}
		return overlayScrollbarsLoader;
	}

	async function initCustomScrollbar() {
		// 不对 body/html 初始化 OverlayScrollbars：会晚于首屏写入
		// data-overlayscrollbars / data-overlayscrollbars-viewport，并注入
		// .os-scrollbar，触发二次布局（硬刷新「双刷」）。Firefly 也无此逻辑。
		// 仅给代码块、KaTeX 等局部容器加自定义滚动条。
		const { OverlayScrollbars } = await loadOverlayScrollbars();
		const preElements = document.querySelectorAll(
			"pre:not(.expressive-code pre)",
		);
		preElements.forEach((ele) => {
			if (ele.closest(".expressive-code")) return;
			OverlayScrollbars(ele, {
				scrollbars: {
					theme: "scrollbar-base scrollbar-dark px-2",
					autoHide: "leave",
					autoHideDelay: 500,
					autoHideSuspend: false,
				},
			});
		});
		const katexElements = document.querySelectorAll(
			".katex-display",
		) as NodeListOf<HTMLElement>;
		katexElements.forEach((ele) => {
			OverlayScrollbars(ele, {
				scrollbars: {
					theme: "scrollbar-base scrollbar-auto py-1",
				},
			});
		});
	}

	function initCustomScrollbarDeferred() {
		const idle = (window as any).requestIdleCallback as
			| ((callback: () => void, options?: { timeout: number }) => void)
			| undefined;
		if (idle) {
			idle(() => {
				void initCustomScrollbar();
			}, { timeout: 2000 });
			return;
		}
		setTimeout(() => {
			void initCustomScrollbar();
		}, 100);
	}

	function showBanner() {
		const banner = document.getElementById("banner");
		if (!banner) {
			console.error("Failed to find the banner element");
			return;
		}
		if (banner.dataset.revealed === "1") return;
		banner.dataset.revealed = "1";
		banner.classList.remove("opacity-0", "scale-105");
	}

	function init() {
		// disableAnimation()()		// TODO
		loadTheme();
		loadHue();
		initCustomScrollbarDeferred();
		initWallpaperFromStorage();
		// 直接打开 fullscreen 非首页时滚到正文（Swup 未参与）
		const mode = document.documentElement.getAttribute("data-wallpaper-mode");
		if (
			mode === "fullscreen" &&
			!pathsEqual(window.location.pathname, url("/"))
		) {
			requestAnimationFrame(() => scrollToFullscreenContent("auto"));
		}
		showBanner();
	}

	function runInit() {
		init();
	}

	/* Load settings when entering the site */
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", runInit, { once: true });
	} else {
		runInit();
	}

	let lightbox: any = (window as any).__layoutPhotoSwipeInstance;

	function hasPhotoSwipeTargets() {
		return !!document.querySelector(".custom-md img, #post-cover img");
	}

	async function createPhotoSwipe() {
		if (lightbox) return;
		if (!hasPhotoSwipeTargets()) return;
		const [{ default: PhotoSwipeLightbox }] = await Promise.all([
			import("photoswipe/lightbox"),
			import("photoswipe/style.css"),
		]);

		lightbox = new PhotoSwipeLightbox({
			gallery: ".custom-md img, #post-cover img",
			pswpModule: () => import("photoswipe"),
			padding: { top: 20, bottom: 20, left: 20, right: 20 },
			wheelToZoom: true,
			arrowPrev: false,
			arrowNext: false,
			imageClickAction: "close",
			tapAction: "close",
			doubleTapAction: "zoom",
		});

		lightbox?.addFilter(
			"domItemData",
			(
				itemData: {
					src?: string;
					w?: number;
					h?: number;
					msrc?: string;
				},
				element: unknown,
			) => {
				if (element instanceof HTMLImageElement) {
					itemData.src = element.src;

					itemData.w = Number(
						element.naturalWidth || window.innerWidth,
					);
					itemData.h = Number(
						element.naturalHeight || window.innerHeight,
					);

					itemData.msrc = element.src;
				}

				return itemData;
			},
		);

		lightbox?.init();
		(window as any).__layoutPhotoSwipeInstance = lightbox;
	}

	const setup = () => {
		// 全屏壁纸模式：替换 swup 默认回顶（Firefly 同款）
		// 首页回顶，其他页滚到 #main-panel / #main-grid
		window.swup.hooks.replace(
			"scroll:top",
			(visit: { to: { url: string } }, args: { options: ScrollIntoViewOptions }) => {
				handleWallpaperScrollTop(visit.to.url, args.options);
				return true;
			},
		);

		// TODO: temp solution to change the height of the banner
		/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
		window.swup.hooks.on("link:click", () => {
			// Remove the delay for the first time page load
			document.documentElement.style.setProperty(
				"--content-delay",
				"0ms",
			);

			// prevent elements from overlapping the navbar
			if (!isBannerWallpaperMode()) {
				return;
			}
			let threshold =
				window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16;
			let navbar = document.getElementById("navbar-wrapper");
			if (!navbar || !document.body.classList.contains("lg:is-home")) {
				return;
			}
			if (
				document.body.scrollTop >= threshold ||
				document.documentElement.scrollTop >= threshold
			) {
				navbar.classList.add("navbar-hidden");
			}
		});
		window.swup.hooks.on("content:replace", () => {
			initCustomScrollbarDeferred();
		});
		window.swup.hooks.on(
			"visit:start",
			(visit: { to: { url: string } }) => {
				// 与原版 Fuwari 一致：只切换 lg:is-home，交给 CSS duration-700 插值
				const bodyElement = document.querySelector("body");
				const isBannerWallpaper =
					document.documentElement.getAttribute(
						"data-wallpaper-mode",
					) === "banner";
				if (isBannerWallpaper) {
					if (pathsEqual(visit.to.url, url("/"))) {
						bodyElement!.classList.add("lg:is-home");
					} else {
						bodyElement!.classList.remove("lg:is-home");
					}
				}

				handleWallpaperVisitStart(visit.to.url);

				// fuwari：不在 visit:start 滚动，由 scroll:top + 壳层 700ms 协调对齐

				// increase the page height during page transition to prevent the scrolling animation from jumping
				const heightExtend =
					document.getElementById("page-height-extend");
				if (heightExtend) {
					heightExtend.classList.remove("hidden");
				}

				// 页面切换时关闭 TOC 面板
				const tocPanel = document.getElementById("toc-panel");
				if (tocPanel) {
					tocPanel.classList.add("float-panel-closed");
				}
			},
		);
		window.swup.hooks.on("page:view", () => {
			handleWallpaperPageView();

			// hide the temp high element when the transition is done
			const heightExtend = document.getElementById("page-height-extend");
			if (heightExtend) {
				heightExtend.classList.remove("hidden");
			}
			showBanner();
			void createPhotoSwipe();
			refreshFloatingControls();
			attachSidebarListeners();
			scrollFunction();
			initImageLoadFadeIn();
		});
		window.swup.hooks.on(
			"content:replace",
			() => {
				lightbox?.destroy?.();
				lightbox = null;
				(window as any).__layoutPhotoSwipeInstance = null;
			},
			{ before: true },
		);
		window.swup.hooks.on("visit:end", (visit: { to: { url: string } }) => {
			setTimeout(() => {
				const heightExtend =
					document.getElementById("page-height-extend");
				if (heightExtend) {
					heightExtend.classList.add("hidden");
				}
			}, 200);
		});

		void createPhotoSwipe();
	};
	bindWhenSwupReady(setup, "__layoutSwupHooksBound");

	let backToTopBtn = document.getElementById("back-to-top-btn");
	let leftBackToTopBtn = document.getElementById("left-back-to-top-btn");
	let tocToggleBtn = document.getElementById("toc-toggle-btn");
	let tocPanel = document.getElementById("toc-panel");
	let navbar = document.getElementById("navbar-wrapper");

	function refreshFloatingControls() {
		backToTopBtn = document.getElementById("back-to-top-btn");
		leftBackToTopBtn = document.getElementById("left-back-to-top-btn");
		tocToggleBtn = document.getElementById("toc-toggle-btn");
		tocPanel = document.getElementById("toc-panel");
		navbar = document.getElementById("navbar-wrapper");
	}

	function isArticlePage() {
		return /^\/posts\/.+/.test(window.location.pathname);
	}

	function scrollFunction() {
		const scrollTop = window.scrollY || document.documentElement.scrollTop;
		let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100);
		const reachedBannerThreshold = scrollTop > bannerHeight;
		const articlePage = isArticlePage();

		if (backToTopBtn) {
			backToTopBtn.classList.toggle(
				"hide",
				!(articlePage && reachedBannerThreshold),
			);
		}

		// 同步控制左侧的浮动按钮显示
		if (leftBackToTopBtn) {
			leftBackToTopBtn.classList.toggle(
				"hide",
				!(articlePage && reachedBannerThreshold),
			);
		}

		// 同步控制 TOC 按钮显示，并在隐藏时同步关闭目录面板
		if (tocToggleBtn) {
			const shouldHideTocToggle = !(articlePage && reachedBannerThreshold);
			tocToggleBtn.classList.toggle("hide", shouldHideTocToggle);
			if (shouldHideTocToggle && tocPanel) {
				tocPanel.classList.add("float-panel-closed");
			}
		}

		if (!isBannerWallpaperMode()) return;
		if (navbar) {
			const NAVBAR_HEIGHT = 72;
			const MAIN_PANEL_EXCESS_HEIGHT =
				MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16; // The height the main panel overlaps the banner

			let bannerHeight = BANNER_HEIGHT;
			if (
				document.body.classList.contains("lg:is-home") &&
				window.innerWidth >= 1024
			) {
				bannerHeight = BANNER_HEIGHT_HOME;
			}
			let threshold =
				window.innerHeight * (bannerHeight / 100) -
				NAVBAR_HEIGHT -
				MAIN_PANEL_EXCESS_HEIGHT -
				16;
			if (scrollTop >= threshold) {
				navbar.classList.add("navbar-hidden");
			} else {
				navbar.classList.remove("navbar-hidden");
			}
		}
	}
	let isScrollTicking = false;
	if (!(window as any).__layoutScrollBound) {
		window.addEventListener(
			"scroll",
			() => {
				if (isScrollTicking) return;
				isScrollTicking = true;
				requestAnimationFrame(() => {
					scrollFunction();
					isScrollTicking = false;
				});
			},
			{ passive: true },
		);
		(window as any).__layoutScrollBound = true;
	}

	// Attach sidebar button listeners
	function attachSidebarListeners() {
		const tocToggleBtn = document.getElementById("toc-toggle-btn");
		if (tocToggleBtn && !(tocToggleBtn as HTMLElement).dataset.boundClick) {
			(tocToggleBtn as HTMLElement).dataset.boundClick = "1";
			tocToggleBtn.addEventListener("click", () => {
				document
					.getElementById("toc-panel")
					?.classList.toggle("float-panel-closed");
			});
		}

		const leftBtn = document.getElementById("left-back-to-top-btn");
		if (leftBtn && !(leftBtn as HTMLElement).dataset.boundClick) {
			(leftBtn as HTMLElement).dataset.boundClick = "1";
			leftBtn.addEventListener("click", () => {
				window.scroll({ top: 0, behavior: "smooth" });
			});
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", attachSidebarListeners);
	} else {
		attachSidebarListeners();
	}

	refreshFloatingControls();
	scrollFunction();

	/** LQIP：图片加载完成后显示图片并淡出占位渐变 */
	function initImageLoadFadeIn() {
		const placeholders = document.querySelectorAll<HTMLElement>(
			".lqip-placeholder",
		);
		placeholders.forEach((placeholder) => {
			const container = placeholder.parentElement;
			if (!container) return;
			const img = container.querySelector<HTMLImageElement>("img");
			if (!img) return;

			const reveal = () => {
				img.style.opacity = "1";
				placeholder.classList.add("loaded");
			};

			if (img.complete && img.naturalWidth > 0) {
				reveal();
			} else {
				img.addEventListener("load", reveal, { once: true });
				img.addEventListener(
					"error",
					() => {
						placeholder.classList.add("loaded");
					},
					{ once: true },
				);
			}
		});
	}

	initImageLoadFadeIn();
	document.addEventListener("astro:page-load", initImageLoadFadeIn);

	// (listeners attached via attachSidebarListeners)
	window.addEventListener("resize", () => {
		// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
		let offset = Math.floor(
			window.innerHeight * (BANNER_HEIGHT_EXTEND / 100),
		);
		offset = offset - (offset % 4);
		document.documentElement.style.setProperty(
			"--banner-height-extend",
			`${offset}px`,
		);
		syncWallpaperLayoutOnResize();
	});
</script>
